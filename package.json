{
  "name": "@ssig-it/zep-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for the ZEP REST API (time tracking, projects, invoices)",
  "license": "MIT",
  "author": "SSIG-IT GmbH",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "zep-mcp-server": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "server.json",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "zep",
    "zep-online",
    "time-tracking",
    "zeiterfassung"
  ],
  "homepage": "https://github.com/SSIG-IT/zep-mcp-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SSIG-IT/zep-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/SSIG-IT/zep-mcp-server/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "sync-spec": "tsx scripts/sync-spec.ts",
    "generate-zod": "tsx scripts/generate-zod.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.0.0",
    "p-limit": "^6.0.0",
    "pino": "^9.0.0",
    "undici": "^7.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "msw": "^2.0.0",
    "openapi-zod-client": "^1.18.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
