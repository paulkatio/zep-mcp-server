{
  "name": "@ssig-it/zep-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for ZEP HR & time-tracking (employees, attendances, absences, departments, devices)",
  "license": "MIT",
  "author": "Paul-Harald Katio <paulkatio@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "zep-mcp-server": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "server.json",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "zep",
    "hr",
    "time-tracking",
    "attendance",
    "absence-management",
    "zeiterfassung"
  ],
  "homepage": "https://github.com/paulkatio/zep-mcp-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulkatio/zep-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/paulkatio/zep-mcp-server/issues"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "dev": "tsx watch src/index.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "sync-spec": "tsx scripts/sync-spec.ts",
    "generate-zod": "tsx scripts/generate-zod.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.0.0",
    "p-limit": "^6.0.0",
    "pino": "^9.0.0",
    "undici": "^7.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.6.0",
    "msw": "^2.0.0",
    "openapi-zod-client": "^1.18.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.10"
  }
}
