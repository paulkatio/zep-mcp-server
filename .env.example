# ── ZEP MCP Server — environment variables ────────────────────────────────
# Copy to `.env` for local development. NEVER commit the real `.env`.

# Bearer token from the ZEP module "ZEP-Schnittstellen". REQUIRED.
# Sent only in the Authorization header — never logged, never exposed to the LLM.
ZEP_API_TOKEN=

# Tenant name = URL path segment, e.g. "ssig-it". REQUIRED.
ZEP_TENANT=

# Override of the ZEP API base URL (sandbox / self-hosting). Optional.
# Default: https://www.zep-online.de/${ZEP_TENANT}/next/api/v1
ZEP_BASE_URL=

# HTTP timeout per request, in milliseconds. Optional. Default: 30000.
ZEP_REQUEST_TIMEOUT_MS=

# Retries on 5xx / 429 with exponential backoff. Optional. Default: 3.
ZEP_MAX_RETRIES=

# Max parallel requests against ZEP. Optional. Default: 5.
# Temporarily dropped to 1 while rate-limited (HTTP 429).
ZEP_CONCURRENCY_LIMIT=

# pino log level for the app logger: trace | debug | info | warn | error.
# Optional. Default: info.
LOG_LEVEL=

# Optional file path for the audit logger (DELETE/PUT/PATCH trail).
# Without it, audit records go to stderr with a stream marker field.
AUDIT_LOG_PATH=
